<button
  id="theme-toggle"
  type="button"
  class="group relative inline-flex h-12 w-12 items-center justify-center rounded-full
         border border-slate-200/70 bg-white/80 text-slate-700 shadow-sm backdrop-blur
         transition-all duration-300 ease-out
         hover:-translate-y-0.5 hover:scale-[1.03] hover:bg-white hover:shadow-md
         focus:outline-none focus:ring-2 focus:ring-sky-500/40 focus:ring-offset-2
         dark:border-slate-700/80 dark:bg-slate-900/80 dark:text-slate-200
         dark:hover:bg-slate-900 dark:focus:ring-sky-400/30 dark:focus:ring-offset-slate-950"
  aria-label="Toggle color theme"
  title="Toggle color theme"
>
  <span
    class="pointer-events-none absolute inset-0 rounded-full bg-gradient-to-b from-white/60 to-transparent opacity-70 dark:from-white/10"
  ></span>

  <span class="relative block h-5 w-5">
    <!-- Moon -->
    <svg
      id="icon-moon"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="currentColor"
      class="absolute inset-0 h-6 w-6 origin-center
             scale-75 rotate-45 opacity-0
             transition-all duration-300 ease-out
             dark:scale-100 dark:rotate-0 dark:opacity-100"
    >
      <path d="M21.752 15.002A9 9 0 1112.998 2.25a7.5 7.5 0 008.754 12.752z"
      ></path>
    </svg>

    <!-- Sun -->
    <svg
      id="icon-sun"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="currentColor"
      class="absolute inset-0 h-5 w-5 origin-center
             scale-100 rotate-0 opacity-100
             transition-all duration-300 ease-out
             dark:scale-75 -rotate-45 dark:opacity-0"
    >
      <path
        d="M12 2.75a.75.75 0 01.75.75v1.5a.75.75 0 01-1.5 0V3.5a.75.75 0 01.75-.75Zm0 14.75a.75.75 0 01.75.75v1.5a.75.75 0 01-1.5 0V18.25a.75.75 0 01.75-.75ZM4.22 5.28a.75.75 0 011.06 0l1.06 1.06a.75.75 0 11-1.06 1.06L4.22 6.34a.75.75 0 010-1.06Zm13.44 13.44a.75.75 0 011.06 0l1.06 1.06a.75.75 0 01-1.06 1.06l-1.06-1.06a.75.75 0 010-1.06ZM2.75 12a.75.75 0 01.75-.75H5a.75.75 0 010 1.5H3.5a.75.75 0 01-.75-.75Zm16.25 0a.75.75 0 01.75-.75h1.5a.75.75 0 010 1.5h-1.5A.75.75 0 0119 12ZM5.28 19.78a.75.75 0 010-1.06l1.06-1.06a.75.75 0 111.06 1.06l-1.06 1.06a.75.75 0 01-1.06 0ZM18.72 6.34a.75.75 0 010-1.06l1.06-1.06a.75.75 0 111.06 1.06L19.78 6.34a.75.75 0 01-1.06 0ZM12 7.25A4.75 4.75 0 1016.75 12 4.756 4.756 0 0012 7.25Z"
      ></path>
    </svg>
  </span>
</button>

<script is:inline>
  const button = document.getElementById("theme-toggle");

  button?.addEventListener("click", () => {
    const root = document.documentElement;
    const isDark = root.classList.toggle("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
  });
</script>
