---
const { profile } = Astro.props;
---

<section
  id="education"
  class="mx-auto max-w-6xl scroll-mt-24 px-6 py-6 md:px-10 md:py-8"
>
  <div class="mb-8">
    <p
      class="text-sm font-semibold uppercase tracking-[0.22em] text-slate-400 dark:text-slate-500"
    >
      Education
    </p>
    <h2
      class="mt-3 text-3xl font-semibold tracking-[-0.035em] text-slate-950 md:text-4xl dark:text-white"
    >
      Education and executive development
    </h2>
  </div>

  <div class="grid gap-4 md:grid-cols-2">
    {
      profile.education.map((item) => (
        <div class="rounded-[1.75rem] border border-white/80 bg-white/72 p-5 text-slate-700 shadow-[0_18px_60px_rgba(15,23,42,0.08)] backdrop-blur-xl dark:border-white/10 dark:bg-slate-900/55 dark:text-slate-300">
          <p class="text-base font-medium leading-7 text-slate-700 dark:text-slate-200">
            {item}
          </p>
        </div>
      ))
    }
  </div>
</section>
