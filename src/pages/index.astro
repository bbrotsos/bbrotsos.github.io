---
import Layout from "../layouts/Layout.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Experience from "../components/Experience.astro";
import Education from "../components/Education.astro";

import { profile } from "../data/profile";
---

<Layout
  title={profile.name + " | Data and AI Leadership"}
  description="Brian Brotsos is a public-sector data and AI executive leading enterprise strategy, governance, and modernization."
>
  <header class="fixed inset-x-0 top-0 z-50">
    <div class="mx-auto max-w-6xl px-4 pt-4 md:px-10">
      <nav
        class="flex flex-wrap items-center justify-between gap-2 rounded-[1.75rem] border border-white/80 bg-white/72 px-3 py-3 shadow-[0_18px_60px_rgba(15,23,42,0.08)] backdrop-blur-2xl dark:border-white/10 dark:bg-slate-950/65 sm:flex-nowrap sm:rounded-full sm:px-4"
        aria-label="Primary"
      >
        <a
          href="#top"
          class="shrink-0 rounded-full px-2.5 py-2 text-xs font-semibold tracking-[0.18em] text-slate-950 transition hover:bg-slate-100/80 dark:text-white dark:hover:bg-slate-800/80 sm:px-3 sm:text-sm sm:tracking-[0.22em]"
        >
          BB
        </a>

        <div class="flex min-w-0 flex-1 flex-wrap items-center justify-end gap-1 sm:flex-nowrap sm:gap-2">
          <a
            href="#experience"
            data-nav-link
            class="rounded-full px-2.5 py-2 text-xs font-medium text-slate-600 transition duration-300 hover:bg-slate-100/90 hover:text-slate-950 data-[active=true]:bg-slate-950 data-[active=true]:text-white data-[active=true]:shadow-[0_10px_30px_rgba(15,23,42,0.16)] dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white dark:data-[active=true]:bg-white dark:data-[active=true]:text-slate-950 sm:px-3 sm:text-sm"
          >
            Experience
          </a>
          <a
            href="#education"
            data-nav-link
            class="rounded-full px-2.5 py-2 text-xs font-medium text-slate-600 transition duration-300 hover:bg-slate-100/90 hover:text-slate-950 data-[active=true]:bg-slate-950 data-[active=true]:text-white data-[active=true]:shadow-[0_10px_30px_rgba(15,23,42,0.16)] dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white dark:data-[active=true]:bg-white dark:data-[active=true]:text-slate-950 sm:px-3 sm:text-sm"
          >
            Education
          </a>
          <a
            href="#contact"
            data-nav-link
            class="rounded-full px-2.5 py-2 text-xs font-medium text-slate-600 transition duration-300 hover:bg-slate-100/90 hover:text-slate-950 data-[active=true]:bg-slate-950 data-[active=true]:text-white data-[active=true]:shadow-[0_10px_30px_rgba(15,23,42,0.16)] dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white dark:data-[active=true]:bg-white dark:data-[active=true]:text-slate-950 sm:px-3 sm:text-sm"
          >
            Contact
          </a>
          <div class="shrink-0">
            <ThemeToggle />
          </div>
        </div>
      </nav>
    </div>
  </header>

  <Hero profile={profile} />
  <About profile={profile} />
  <Experience profile={profile} />
  <Education profile={profile} />
  <section
    id="contact"
    class="mx-auto max-w-6xl scroll-mt-24 px-6 py-6 md:px-10 md:py-8"
  >
    <div
      class="relative overflow-hidden rounded-[2rem] border border-white/80 bg-white/72 p-7 shadow-[0_18px_60px_rgba(15,23,42,0.08)] backdrop-blur-xl dark:border-white/10 dark:bg-slate-900/55 md:p-8"
    >
      <div
        class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/90 to-transparent dark:via-slate-400/40"
      >
      </div>
      <p
        class="text-sm font-semibold uppercase tracking-[0.22em] text-slate-400 dark:text-slate-500"
      >
        Contact
      </p>
      <h2
        class="mt-3 text-3xl font-semibold tracking-[-0.035em] text-slate-950 dark:text-white"
      >
        Let’s connect
      </h2>
      <p
        class="mt-4 max-w-2xl text-base leading-7 text-slate-600 dark:text-slate-300"
      >
        For leadership, strategy, data modernization, or AI transformation
        conversations, reach out directly.
      </p>

      <div class="mt-6 flex flex-wrap gap-4">
        <a
          href={`mailto:${profile.email}`}
          onclick="gtag('event', 'resume_click', { event_category: 'engagement' })"
          class="rounded-full bg-slate-950 px-6 py-3 text-sm font-medium text-white shadow-[0_14px_30px_rgba(15,23,42,0.18)] transition duration-300 hover:-translate-y-0.5 hover:shadow-[0_18px_36px_rgba(15,23,42,0.22)] dark:bg-white dark:text-slate-950"
        >
          {profile.email}
        </a>

        <a
          href={profile.linkedin}
          target="_blank"
          rel="noreferrer"
          onclick="gtag('event', 'resume_click', { event_category: 'engagement' })"
          class="rounded-full border border-slate-200/80 bg-white/70 px-6 py-3 text-sm font-medium text-slate-700 shadow-[0_10px_30px_rgba(15,23,42,0.06)] backdrop-blur-xl transition duration-300 hover:-translate-y-0.5 hover:border-slate-300 hover:bg-white dark:border-slate-700/80 dark:bg-slate-950/60 dark:text-slate-200 dark:hover:bg-slate-900"
        >
          View LinkedIn
        </a>
      </div>
    </div>
  </section>

  <script is:inline>
    const navLinks = Array.from(document.querySelectorAll("[data-nav-link]"));

    const sectionEntries = navLinks
      .map((link) => {
        const href = link.getAttribute("href");
        const target = href ? document.querySelector(href) : null;
        if (!href || !target) return null;
        return { href, link, target };
      })
      .filter(Boolean);

    const setActiveLink = (href) => {
      navLinks.forEach((link) => {
        const isActive = link.getAttribute("href") === href;
        link.dataset.active = isActive ? "true" : "false";
        if (isActive) {
          link.setAttribute("aria-current", "true");
        } else {
          link.removeAttribute("aria-current");
        }
      });
    };

    if (sectionEntries.length) {
      const visibleSections = new Map();

      const pickActiveSection = () => {
        if (!visibleSections.size) return;

        const active = [...visibleSections.entries()].sort((a, b) => {
          if (b[1].ratio !== a[1].ratio) {
            return b[1].ratio - a[1].ratio;
          }
          return a[1].top - b[1].top;
        })[0]?.[0];

        if (active) setActiveLink(active);
      };

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const href = `#${entry.target.id}`;

            if (entry.isIntersecting) {
              visibleSections.set(href, {
                ratio: entry.intersectionRatio,
                top: entry.boundingClientRect.top,
              });
            } else {
              visibleSections.delete(href);
            }
          });

          pickActiveSection();
        },
        {
          rootMargin: "-30% 0px -45% 0px",
          threshold: [0.15, 0.35, 0.55, 0.75],
        },
      );

      sectionEntries.forEach(({ href, link, target }) => {
        observer.observe(target);
        link.dataset.active = "false";
        link.addEventListener("click", () => setActiveLink(href));
      });

      const initialHash = window.location.hash;
      const initialHref = sectionEntries.some(
        ({ href }) => href === initialHash,
      )
        ? initialHash
        : sectionEntries[0].href;

      setActiveLink(initialHref);
    }
  </script>
</Layout>
